# Generate with: openssl rand -hex 32
PAGES_API_KEY=
# Origin used in returned links. Set to your internal HTTPS hostname.
PUBLIC_URL=http://localhost:3000
# Docker host binding; use the host's LAN IP to expose Pages on your LAN only.
PAGES_BIND_ADDRESS=127.0.0.1
PAGES_PORT=3000
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
MAX_UPLOAD_MB=25
